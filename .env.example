# ============================================
# AICheck — пример переменных окружения
# Скопируй в .env (gitignored) и заполни нужные значения
# ============================================

# ----- Database (нужно для Chunk 1) -----
POSTGRES_USER=aicheck
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=aicheck
DATABASE_URL=postgresql+asyncpg://aicheck:changeme_strong_password_here@localhost:5432/aicheck

# ----- Auth (нужно для Chunk 3) -----
SECRET_KEY=__GENERATE_RANDOM_64_CHARS__
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Redis (нужно для Chunk 1, broker для Celery) -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----- ChromaDB (RAG, Chunk 8) -----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=/data/chromadb

# ----- S3 / MinIO (нужно для Chunk 5) -----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aicheck-uploads

# ----- Mathpix API (Chunk 7) -----
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ----- YandexVision OCR (опционально для Chunk 7 гибрид-провайдера) -----
YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=

# ----- Gemini 2.5 Flash (если выбрана как OCR в Chunk 7) -----
GEMINI_API_KEY=

# ----- OpenAI / Claude через посредника (Chunk 8) -----
# Базовый URL зарубежного посредника (proxy)
OPENAI_API_BASE=https://__YOUR_PROXY_URL__/v1
OPENAI_API_KEY=
ANTHROPIC_API_BASE=https://__YOUR_PROXY_URL__/anthropic
ANTHROPIC_API_KEY=

# Названия моделей
ANALYSIS_EXTRACT_MODEL=gpt-5.4-mini
ANALYSIS_FEEDBACK_MODEL=gpt-5.4
ANALYSIS_FALLBACK_MODEL=claude-sonnet-4-6

# OCR-провайдер (выбирается после валидации в Chunk 7)
OCR_PROVIDER=mathpix_only  # mathpix_only | mathpix_yandex_hybrid | gemini_oneshot

# ----- OAuth (Chunk 3, опционально на старте) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ----- Email (Chunk 9) -----
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_BACKEND=console  # console на dev, mailgun на prod
EMAIL_FROM=AICheck <noreply@localhost>

# ----- Telegram Bot (Chunk 12) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AICheckBot
TELEGRAM_WEBHOOK_URL=  # пусто = polling режим (dev)

# ----- ЮКасса (Chunk 13, skeleton) -----
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# ----- Application -----
ENVIRONMENT=development  # development | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# Уровень логирования
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR

# Marketplace gating
MARKETPLACE_PUBLIC_THRESHOLD=50  # количество репетиторов для публичного маркетплейса

# ----- AI strictness defaults -----
DEFAULT_AI_STRICTNESS=medium  # strict | medium | loose
